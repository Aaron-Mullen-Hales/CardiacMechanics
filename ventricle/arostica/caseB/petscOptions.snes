# JFNK operator with the clean build's assembled mixed D-p preconditioner.
-snes_type newtonls
-snes_linesearch_type basic
-snes_rtol 1e-6
-snes_atol 1e-12
-snes_stol 1e-8
-snes_max_it 20
-snes_monitor
-snes_converged_reason
-snes_max_funcs 100000
-snes_mf
-snes_mf_operator

-ksp_type lgmres
-ksp_gmres_restart 200
-ksp_rtol 1e-2
-ksp_max_it 1000
-ksp_converged_reason

-pc_type fieldsplit
-pc_fieldsplit_block_size 4
-pc_fieldsplit_0_fields 0,1,2
-pc_fieldsplit_1_fields 3
-pc_fieldsplit_type schur
-pc_fieldsplit_schur_factorization_type full
-pc_fieldsplit_schur_precondition selfp
-fieldsplit_0_ksp_type preonly
-fieldsplit_0_pc_type hypre
-fieldsplit_0_pc_hypre_type boomeramg
-fieldsplit_1_ksp_type preonly
-fieldsplit_1_pc_type hypre
-fieldsplit_1_pc_hypre_type boomeramg

-snes_linesearch_monitor
