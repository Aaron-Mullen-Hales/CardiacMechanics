    xMin { type calculated; value uniform (1 0 0); }
    xMax { type calculated; value uniform (1 0 0); }
    yMin { type calculated; value uniform (1 0 0); }
    yMax { type calculated; value uniform (1 0 0); }
    zMin { type calculated; value uniform (1 0 0); }
    zMax { type calculated; value uniform (1 0 0); }
}

