/*--------------------------------*- C++ -*----------------------------------*\
| solids4foam: solid mechanics and fluid-solid interaction simulations        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application         solids4Foam;

startFrom           startTime;
startTime           0;
stopAt              endTime;

// The loaded face is ramped 0 -> 0.5 over t = 0 -> 0.5 on a unit cube, so
// the applied stretch is lambda = 1 + time, i.e. 1.0 -> 1.5.
endTime             0.5;
deltaT              0.05;

writeControl        timeStep;
writeInterval       1;
purgeWrite          0;

writeFormat         ascii;
writePrecision      12;
writeCompression    off;
timeFormat          general;
timePrecision       8;

runTimeModifiable   false;

// ************************************************************************* //
