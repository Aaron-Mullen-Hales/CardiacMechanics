# Jacobian-free Newton-Krylov, matching the recipe already proven on
# ventricle/land/problem1: the hand-coded Jacobian (formJacobian) only
# includes the generic numerical stabilisation term, not the real
# constitutive tangent or D_x/D_y/D_z cross-coupling -- fine when a boundary
# DOF is Dirichlet-constrained, but produces a genuinely wrong Newton
# direction at a free (solidTraction) DOF whose equilibrium is actually
# governed by that missing tangent. -snes_mf/-snes_mf_operator makes the
# actual Newton step use a matrix-free (effectively exact) Jacobian action,
# using the hand-coded matrix only as a preconditioner.
#
# Unlike cube1 (which loads directly along the fibre axis and needs
# trust-region + adaptive continuation, see cube1/petscOptions.split), this
# JFNK config alone reaches the full lambda=1.0->1.5 range for cube2 with
# excellent accuracy (case a: 1e-6 to 1e-8 relative error throughout; case c:
# <0.06% to lambda~1.3, drifting to ~19% by lambda=1.5 but never crashing) --
# verified against ../analytical/compare_cube_runs.py.
-snes_type newtonls
-snes_linesearch_type bt
# Loosened from 1e-11/1e-10/1e-12: at these coefficient magnitudes
# (pressureEqnScale ~ 2e5, stiffness ~ 1e5-1e6) the matrix-free Jacobian's
# own finite-difference precision floor sits around 1e-5 relative, so
# tighter targets are unreachable noise, not real non-convergence.
-snes_atol 1e-6
-snes_rtol 1e-5
-snes_stol 1e-10
-snes_max_it 200
-snes_converged_reason

-snes_mf
-snes_mf_operator
-snes_max_linear_solve_fail 10000000
-snes_max_funcs 100000000

-ksp_type lgmres
-ksp_gmres_restart 200
-ksp_rtol 1e-8
-ksp_max_it 1000
-ksp_converged_reason
-pc_type fieldsplit
-pc_fieldsplit_block_size 4
-pc_fieldsplit_0_fields 0,1,2
-pc_fieldsplit_1_fields 3
-pc_fieldsplit_type schur
-pc_fieldsplit_schur_factorization_type lower
-pc_fieldsplit_schur_precondition a11
-fieldsplit_0_ksp_type preonly
-fieldsplit_0_pc_type hypre
-fieldsplit_0_pc_hypre_type boomeramg
-fieldsplit_1_ksp_type preonly
-fieldsplit_1_pc_type hypre
-fieldsplit_1_pc_hypre_type boomeramg

-snes_lag_preconditioner_persists true
-snes_lag_preconditioner -2
-snes_linesearch_alpha 1e-8
-snes_linesearch_minlambda 1e-12
